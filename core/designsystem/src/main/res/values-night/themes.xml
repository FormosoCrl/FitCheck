<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.FitCheck" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/fc_teal_80</item>
        <item name="colorOnPrimary">@color/fc_slate_10</item>
        <item name="colorPrimaryContainer">@color/fc_teal_40</item>
        <item name="colorOnPrimaryContainer">@color/fc_teal_90</item>

        <item name="colorSecondary">@color/fc_slate_90</item>
        <item name="colorOnSecondary">@color/fc_slate_10</item>

        <item name="colorError">@color/fc_red_50</item>
        <!-- En oscuro hace falta un ambar mas claro o no se lee sobre el fondo. -->
        <item name="fitcheckRecordColor">@color/fc_amber_50</item>
        <item name="colorOnError">@color/fc_white</item>
        <item name="colorErrorContainer">@color/fc_red_40</item>

        <item name="android:colorBackground">@color/fc_slate_10</item>
        <item name="colorSurface">@color/fc_slate_20</item>
        <item name="colorOnSurface">@color/fc_slate_90</item>
        <item name="colorSurfaceVariant">@color/fc_slate_30</item>
        <item name="colorOnSurfaceVariant">@color/fc_slate_60</item>

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>

</resources>
